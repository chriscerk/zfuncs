# GH Collab Update
# Bulk update collaborators across repositories
#
# Pre-reqs:
#
# Installation(s):
# - gh cli
#
# Environmental Variable(s):
# - ORG=some_org
# - GH_TEAM_SLUG=some_team
# - GH_PERMISSION=some-GH_PERMISSION
#
# Option(s):
# - '--dry-run' to run the script in dry-run mode
#
# see:
# - listing repos: https://docs.github.com/en/rest/repos/repos?apiVersion=2022-11-28#list-organization-repositories
# -giving GH_PERMISSION to a team https://docs.github.com/en/rest/teams/teams?apiVersion=2022-11-28#add-or-update-team-repository-GH_PERMISSIONs
__gh-collab-update() {
  echo "GH Collab Update: Bulk update collaborators across repositories"
  echo "-------"
  echo "ORG: ${GH_ORG}"
  echo "GH_TEAM_SLUG: ${GH_TEAM_SLUG}"
  echo "GH_PERMISSION: ${GH_PERMISSION}"
  echo "-------"

  if [[ -z "${GH_ORG}" ]]; then
    echo "GH_ORG is not set. Exiting."
    return 1
  fi

  if [[ -z "${GH_TEAM_SLUG}" ]]; then
    echo "GH_TEAM_SLUG is not set. Exiting."
    return 1
  fi

  if [[ -z "${GH_PERMISSION}" ]]; then
    echo "GH_PERMISSION is not set. Exiting."
    return 1
  fi

  DRY_RUN=false
  if [[ "${1}" == "--dry-run" ]]; then
    DRY_RUN=true
  fi

  gh repo list ${GH_ORG} --limit 1000 | awk '{print $1}' | while read -r OWNED_REPO; do

    ## if dry-run, just echo the command
    if [[ "${DRY_RUN}" == "true" ]]; then
      echo "${OWNED_REPO}"
      continue
    fi
    gh api --method PUT \
      -H "Accept: application/vnd.github.v3.repository+json" -H "X-GitHub-Api-Version: 2022-11-28" \
      /orgs/${ORG}/teams/${GH_TEAM_SLUG}/repos/${OWNED_REPO} -f permission=${GH_PERMISSION}
  done

  echo "-----------"
  echo "GH Collab Update Complete."
}

__gh-collab-update
